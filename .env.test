# Environment of the e2e tests (npm run test:e2e), loaded by test/e2e/test-env.ts.
# It only holds the local docker-compose defaults, no secrets, so it is committed.
# Every variable is listed, so values from a developer's .env never leak into the tests.
# Real environment variables still win over this file, like for the app.
NODE_ENV=test
PORT=3000

# PostgreSQL: a separate database that the tests empty before each test.
# docker/postgres/init creates it; test/e2e/global-setup.ts also creates it
# if the volume predates that script, then runs the migrations.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mini_oms_test
DATABASE_SSL=false
# One connection per concurrent request (IT-02b sends 40 at once), so the
# transactions really run in parallel on Postgres and compete for row locks.
DATABASE_POOL_MAX=40
DATABASE_LOGGING=false
# Far above any lock wait of the tests (a few ms). The tests check that the
# lock order prevents deadlocks, not the timeout: Postgres detects a deadlock
# after deadlock_timeout (1s) whatever this value is. A short value could
# fire spuriously when the clock of the Docker VM jumps (seen: ~14s).
DB_LOCK_TIMEOUT_MS=60000

# Redis / BullMQ: the local Redis. The queue of the e2e tests uses its own key
# prefix (test/e2e/relay-testing-module.ts), so it never touches dev jobs.
REDIS_URL=redis://localhost:6379
JOB_ATTEMPTS=4
JOB_BACKOFF_DELAY_MS=2000
JOB_KEEP_COMPLETED_SECONDS=604800
JOB_KEEP_FAILED_SECONDS=1209600

# Outbox relay (the tests call relayBatch() themselves, no polling loop runs)
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_BACKOFF_MS=30000

# Worker (no BullMQ Worker runs in the e2e tests)
JOB_PROCESSING_MIN_MS=3000
JOB_PROCESSING_MAX_MS=5000
JOB_FAILURE_RATE=0.3
WORKER_CONCURRENCY=5
ORDER_PENDING_TTL_MINUTES=30
EXPIRE_PENDING_EVERY_MS=300000
EXPIRE_BATCH_SIZE=100

# API docs
SWAGGER_ENABLED=true
